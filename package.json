{
  "name": "abarrotes",
  "private": true,
  "description": "Monorepo del Sistema Integral de Ventas y Distribución — Abarrotes",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "node .githooks/install.mjs",
    "api:dev": "npm run start:dev -w apps/api",
    "api:test": "npm test -w apps/api",
    "web:dev": "npm run dev -w apps/web",
    "web:test": "npm test -w apps/web"
  }
}

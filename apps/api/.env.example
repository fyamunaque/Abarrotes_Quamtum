# Copia este archivo a .env y ajusta los valores. Nunca subas el .env al repo.

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/abarrotes?schema=public"

# JWT — usa valores largos y aleatorios, y DISTINTOS entre sí
# (por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Puerto de la API
PORT=3001

# Orígenes permitidos para CORS, separados por coma. Vacío = cualquiera (solo desarrollo).
# La app Kotlin no lo necesita: CORS es solo para navegadores.
CORS_ORIGIN=""

# Admin de prueba que crea `npx prisma db seed` (solo desarrollo; imprime sus credenciales).
# Todo opcional: sin email usa admin@abarrotes.test; sin contraseña genera una al azar
# en cada corrida. Si el usuario ya existe, se le fija esta contraseña y el rol ADMIN.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME=""

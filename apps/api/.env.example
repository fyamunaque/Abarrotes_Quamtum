# Copia este archivo a .env y ajusta los valores. Nunca subas el .env al repo.

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/abarrotes?schema=public"

# JWT — usa valores largos y aleatorios, y DISTINTOS entre sí
# (por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Puerto de la API (Next.js usa el 3000 por defecto)
PORT=3001

# Orígenes permitidos para CORS, separados por coma. Vacío = cualquiera (solo desarrollo).
CORS_ORIGIN="http://localhost:3000"

# Admin inicial que crea `npm run prisma:seed` (si ya existe, no se modifica)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administrador"

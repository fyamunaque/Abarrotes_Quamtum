<?xml version="1.0" encoding="utf-8"?>
<!-- Logo de Neil's (drawable-nodpi/ic_launcher_foreground.png, 432 px = 108 dp en xxxhdpi).
     Sin capa monocromática: el logo es una imagen con fondo propio, así que en los íconos
     temáticos de Android 13+ se muestra el ícono normal. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
